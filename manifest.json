{
  "manifest_version": 3,
  "name": "AU Acknowledgement Blocker",
  "version": "0.1.0",
  "description": "Hides Acknowledgement of Country, Welcome to Country, and cultural warning surfaces, and normalises selected local greetings to welcome.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/aoc-blocker-16.png",
    "32": "icons/aoc-blocker-32.png",
    "48": "icons/aoc-blocker-48.png",
    "96": "icons/aoc-blocker-96.png",
    "128": "icons/aoc-blocker-128.png"
  },
  "action": {
    "default_title": "AU Acknowledgement Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/aoc-blocker-16.png",
      "32": "icons/aoc-blocker-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "au-acknowledgement-blocker@extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
